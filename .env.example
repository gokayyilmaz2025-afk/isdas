APP_ORIGIN=http://127.0.0.1:5173
APP_ENV=development
DATABASE_PATH=data/isdas.sqlite3
REGISTRATION_ENABLED=true
# Development may run without mail. Production requires verified email for public signup.
EMAIL_VERIFICATION_REQUIRED=false
MAIL_WORKER_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Production: generate with python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Separate key for operator backup archives. Preserve it outside the server.
BACKUP_ENCRYPTION_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1
# Admission budgets, UTC calendar months. A running call can exceed its reservation.
DEFAULT_MONTHLY_BUDGET_USD=10
GLOBAL_MONTHLY_BUDGET_USD=100
JOB_RESERVE_USD=0.25
IMAGE_JOB_RESERVE_USD=0.10
RESEARCH_JOB_RESERVE_USD=1
HERMES_JOB_RESERVE_USD=2
# Dedicated Hermes instances are assigned per workspace in data/runtime-map.json.
HERMES_RUNTIME_MAP=data/runtime-map.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_ORIGIN=http://127.0.0.1:8000
